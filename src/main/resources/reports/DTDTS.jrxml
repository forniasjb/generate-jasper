	<queryString>
		<![CDATA[SELECT
    a.orgaunit AS CODE,
    f.orgadesc AS DESC,
    CAST(0.00 AS DECIMAL(15,2)) AS LCOPN,
    '' AS LCOPN_SIGN,
    COALESCE(SUM(CASE WHEN TRIM(a.sign) = '+' THEN a.lcamt ELSE 0 END), 0.00) AS LCDR,
    COALESCE(SUM(CASE WHEN TRIM(a.sign) = '-' THEN a.lcamt ELSE 0 END), 0.00) AS LCCR,
    CAST(0.00 AS DECIMAL(15,2)) AS LCCLS,
    '' AS LCCLS_SIGN
FROM
    CFASLIB.FA0210 a
LEFT OUTER JOIN CFASLIB.FA0740 f ON a.orgaunit = f.orgaunit
WHERE
    a.trdat >= 20250101 AND a.trdat <= 20251231
    AND (a.tridtype BETWEEN '1' AND '9' OR a.tridtype IS NULL)
GROUP BY
    a.orgaunit, f.orgadesc
ORDER BY
    a.orgaunit]]>
	</queryString>
