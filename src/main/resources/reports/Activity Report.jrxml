	</parameter>
	<queryString>
		<![CDATA[SELECT
    CAST(a.ORGAUNIT AS VARCHAR(20)) AS RC_CODE,
    COALESCE(f.F0740_ORGAUNIT_DESC, 'N/A') AS RC_DESC,
    SUBSTR(DIGITS(DECIMAL(a.TRDAT, 8, 0)), 5, 2) || '/' ||
    SUBSTR(DIGITS(DECIMAL(a.TRDAT, 8, 0)), 7, 2) || '/' ||
    SUBSTR(DIGITS(DECIMAL(a.TRDAT, 8, 0)), 1, 4) AS TRANS_DATE,
    CAST(a.TRTYPE AS VARCHAR(20))    AS TRANS_TYPE,
    CAST(a.TICKET AS VARCHAR(20))    AS TICKET_NO,
    CAST(COALESCE(b1.PART1, '') || COALESCE(b2.PART2, '') AS VARCHAR(250)) AS PARTICULARS,
    a.ANALCODE                       AS ANALYSIS_CODE,
    COALESCE(f.F0740_ORGAUNIT_DESC, '') AS INSTITUTION_NAME,
    CASE WHEN TRIM(a.SIGN) = '+' THEN a.LCAMT ELSE 0 END AS DEBIT,
    CASE WHEN TRIM(a.SIGN) = '-' THEN a.LCAMT ELSE 0 END AS CREDIT
FROM CFASLIB.FA0210 a
LEFT JOIN CFASLIB.FA0211LF1 b1
    ON  a.TRDAT    = b1.TRDAT
    AND a.ORGAUNIT = b1.ORGAUNIT
    AND a.TICKET   = b1.TICKET
    AND a.POSTDATE = b1.POSTDATE
    AND a.POSTTIME = b1.POSTTIME
LEFT JOIN CFASLIB.FA0211LF2 b2
    ON  a.TRDAT    = b2.TRDAT
    AND a.ORGAUNIT = b2.ORGAUNIT
    AND a.TICKET   = b2.TICKET
    AND a.POSTDATE = b2.POSTDATE
    AND a.POSTTIME = b2.POSTTIME
LEFT JOIN CFASLIB.FA0740 f
    ON a.ORGAUNIT = f.F0740_ORGAUNIT_CODE
WHERE a.TRDAT BETWEEN 20250101 AND 20251231
  AND a.TICKET BETWEEN 0 AND 999999
ORDER BY a.ORGAUNIT,
         a.TRDAT,
         a.TICKET,
         a.POSTDATE,
         a.POSTTIME,
         a.SIGN,
         a.TICKETSEQ
FETCH FIRST 10 ROWS ONLY]]>
	</queryString>
