	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="fromDate" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[20250101]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[20251231]]></defaultValueExpression>
	</parameter>
