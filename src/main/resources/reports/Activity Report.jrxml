	<field name="CREDIT" class="java.math.BigDecimal"/>
	<variable name="TOTAL_DEBIT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DEBIT}]]></variableExpression>
		<initialValueExpression><![CDATA[new BigDecimal("0.00")]]></initialValueExpression>
	</variable>
	<variable name="TOTAL_CREDIT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{CREDIT}]]></variableExpression>
		<initialValueExpression><![CDATA[new BigDecimal("0.00")]]></initialValueExpression>
	</variable>
	<variable name="ENDING_BALANCE" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$P{beginningBalance}.add($V{TOTAL_DEBIT}).subtract($V{TOTAL_CREDIT})]]></variableExpression>
	</variable>
